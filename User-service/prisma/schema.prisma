generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  // Primary identity (same ID as Auth Service)
  id       String  @id
  // Read model (owned by Auth Service, synchronized via events)
  username String  @unique
  email    String  @unique
  bio      String? @db.VarChar(250)
  profileImagePublicId String? // Cloudinary id (internal, never returned to clients)
  profileImageUrl      String? // shown by the frontend

  // Statistics (maintained through events)
  carpoolCount   Int @default(0)
  projectCount   Int @default(0)
  lostFoundCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// NEW: remembers which events were already applied, so a redelivered event
// (at-least-once delivery) cannot increment a counter twice.
model ProcessedEvent {
  eventId   String   @id
  createdAt DateTime @default(now())

  @@index([createdAt])
}